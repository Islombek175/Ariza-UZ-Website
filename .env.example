# Railway Variables / Raw Editor sample
# SECRET_KEY va DEFAULT_ADMIN_PASSWORD qiymatlarini deploydan oldin albatta almashtiring.

DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret-key

# Railway public domain yaratilgandan keyin bu reference ishlaydi.
ALLOWED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}}
CSRF_TRUSTED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}

DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-to-a-strong-admin-password
# Mavjud admin parolini DEFAULT_ADMIN_PASSWORD qiymatiga yangilash kerak bo'lsa True qiling.
RESET_ADMIN_PASSWORD_ON_SEED=False

SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_REDIRECT_EXEMPT=^health/$
SECURE_HSTS_SECONDS=0
X_FRAME_OPTIONS=DENY

# Productionda demo loginlar yaratilmasin.
CREATE_DEMO_USERS=False

# Fayl uploadlari uchun Railway Volume mount path sifatida /app/media qo'ying.
MEDIA_ROOT=/app/media

# PostgreSQL service variables. Railway'dagi Postgres service nomi boshqacha bo'lsa,
# "Postgres" qismini o'sha service nomiga almashtiring.
PGDATABASE=${{Postgres.PGDATABASE}}
PGUSER=${{Postgres.PGUSER}}
PGPASSWORD=${{Postgres.PGPASSWORD}}
PGHOST=${{Postgres.PGHOST}}
PGPORT=${{Postgres.PGPORT}}

TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/
WEB_CONCURRENCY=2

# Local development uchun kerak bo'lsa quyidagilarni .env ichida ishlating:
# DEBUG=True
# SECRET_KEY=change-me
# ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# DEFAULT_ADMIN_PASSWORD=admin123
# RESET_ADMIN_PASSWORD_ON_SEED=False
# SESSION_COOKIE_SECURE=False
# SECURE_SSL_REDIRECT=False
# X_FRAME_OPTIONS=SAMEORIGIN
# CREATE_DEMO_USERS=True
# MEDIA_ROOT=media
# MINI_APP_URL=http://127.0.0.1:8000/
